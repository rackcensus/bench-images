#!/usr/bin/env python3
import json
import sys


def main(argv):
    if len(argv) != 2:
        raise SystemExit("usage: platform-refs <resolved images json> <platform>")
    resolved = json.load(open(argv[0]))
    platform = argv[1]
    refs = {name: f"{image['repo']}@{image['platforms'][platform]['digest']}" for name, image in resolved["images"].items()}
    print(json.dumps(refs, indent=2))


if __name__ == "__main__":
    main(sys.argv[1:])
