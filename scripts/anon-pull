#!/usr/bin/env python3
import base64
import hashlib
import json
import os
import pathlib
import sys
import urllib.error
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parent.parent

ACCEPT = ", ".join([
    "application/vnd.oci.image.index.v1+json",
    "application/vnd.oci.image.manifest.v1+json",
    "application/vnd.docker.distribution.manifest.list.v2+json",
    "application/vnd.docker.distribution.manifest.v2+json",
])


def fetch(url, headers=None):
    request = urllib.request.Request(url)
    for key, value in (headers or {}).items():
        request.add_unredirected_header(key, value)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return response.status, response.read()
    except urllib.error.HTTPError as error:
        return error.code, error.read()


def anonymous_token(path):
    auth = os.environ.get("RC_PULL_AUTH")
    headers = {"Authorization": "Basic " + base64.b64encode(auth.encode()).decode()} if auth else None
    status, body = fetch(f"https://ghcr.io/token?scope=repository:{path}:pull", headers)
    if status != 200:
        return None, f"anonymous token request returned {status}"
    token = json.loads(body).get("token")
    if not token:
        return None, "anonymous token request returned no token"
    return token, None


def check(name, repo, digests):
    path = repo.removeprefix("ghcr.io/")
    token, problem = anonymous_token(path)
    if problem:
        return problem
    for digest in digests:
        status, _ = fetch(f"https://ghcr.io/v2/{path}/manifests/{digest}",
                          {"Authorization": f"Bearer {token}", "Accept": ACCEPT})
        if status != 200:
            return f"manifest {digest} returned {status}"
    return None


def check_pts_assets():
    lock = json.loads((ROOT / "pts.lock").read_text())
    assets = lock["assets"]
    path = assets["repo"].removeprefix("ghcr.io/")
    token, problem = anonymous_token(path)
    if problem:
        return assets["repo"], problem
    auth = {"Authorization": f"Bearer {token}"}
    status, _ = fetch(f"https://ghcr.io/v2/{path}/manifests/{assets['manifest']}",
                      {**auth, "Accept": "application/vnd.oci.image.manifest.v1+json"})
    if status != 200:
        return assets["repo"], f"manifest {assets['manifest']} returned {status}"
    for item in [lock["archive"]] + lock["downloads"]:
        status, body = fetch(f"https://ghcr.io/v2/{path}/blobs/sha256:{item['sha256']}", auth)
        if status != 200:
            return assets["repo"], f"{item['file']} returned {status}"
        if hashlib.sha256(body).hexdigest() != item["sha256"]:
            return assets["repo"], f"{item['file']} came back with the wrong sha256"
    return assets["repo"], None


def main(argv):
    if len(argv) != 1:
        raise SystemExit("usage: anon-pull <resolved images json>")
    resolved = json.load(open(argv[0]))
    private = []
    for name, image in resolved["images"].items():
        digests = [image["index"]] + [p["digest"] for p in image["platforms"].values()]
        problem = check(name, image["repo"], digests)
        if problem:
            private.append(name)
            print(f"{image['repo']} is not pullable without credentials: {problem}")
        else:
            print(f"{image['repo']} pulls anonymously ({len(digests)} manifests)")
    repo, problem = check_pts_assets()
    if problem:
        private.append(repo.removeprefix("ghcr.io/rackcensus/"))
        print(f"{repo} is not downloadable without credentials: {problem}")
    else:
        print(f"{repo} serves every PTS file anonymously and each one matches pts.lock")
    if private:
        print("these packages need their visibility set to public in the GitHub UI: "
              + ", ".join(f"rackcensus/{name}" for name in private))
        raise SystemExit(1)
    print(f"all {len(resolved['images']) + 1} packages pull anonymously")


if __name__ == "__main__":
    main(sys.argv[1:])
