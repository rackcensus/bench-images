#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
arch=${1:-$(docker version -f '{{.Server.Arch}}')}
builder=${2:-}
seed="$root/build/woo-seed"
discourse_seed="$root/build/discourse-seed"
ghost_seed="$root/build/ghost-seed"
wagtail_seed="$root/build/wagtail-seed"

build() {
  if [ -n "$builder" ]; then
    docker buildx build --builder "$builder" --platform "linux/$arch" "$@"
  else
    docker buildx build --platform "linux/$arch" "$@"
  fi
}

for image in wrk sysbench memtier tfb-postgres; do
  build --load -t "rc/$image:$arch" "$root/images/$image"
  echo "built rc/$image:$arch"
done

if [ ! -s "$seed/woocommerce.json" ]; then
  build --target woo-seed --output "type=local,dest=$seed" "$root/images/woo-app"
  echo "built the woocommerce seed into $seed"
fi

for image in woo-app woo-db; do
  build --build-context "woo-seed=$seed" --load -t "rc/$image:$arch" "$root/images/$image"
  echo "built rc/$image:$arch"
done

if [ ! -s "$discourse_seed/discourse.json" ]; then
  build --target discourse-seed --output "type=local,dest=$discourse_seed" "$root/images/discourse"
  echo "built the discourse seed into $discourse_seed"
fi

build --build-context "discourse-seed=$discourse_seed" --load -t "rc/discourse:$arch" "$root/images/discourse"
echo "built rc/discourse:$arch"

if [ ! -s "$ghost_seed/ghost.json" ]; then
  build --target ghost-seed --output "type=local,dest=$ghost_seed" "$root/images/ghost-app"
  echo "built the ghost seed into $ghost_seed"
fi

for image in ghost-app ghost-db; do
  build --build-context "ghost-seed=$ghost_seed" --load -t "rc/$image:$arch" "$root/images/$image"
  echo "built rc/$image:$arch"
done

if [ ! -s "$wagtail_seed/wagtail.json" ]; then
  build --target wagtail-seed --output "type=local,dest=$wagtail_seed" "$root/images/wagtail-app"
  echo "built the wagtail seed into $wagtail_seed"
fi

for image in wagtail-app wagtail-db; do
  build --build-context "wagtail-seed=$wagtail_seed" --load -t "rc/$image:$arch" "$root/images/$image"
  echo "built rc/$image:$arch"
done
