#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
gh_repo=rackcensus/bench-images
registry=ghcr.io/rackcensus
builder=rc-release
built=(wrk sysbench memtier tfb-postgres woo-app woo-db)
arches=(amd64 arm64)

usage() {
  echo "usage: scripts/release <vYYYY.MM.DD-N> [--built <image tag>] [--verify <verify json>]... [--publish]" >&2
  exit 64
}

[ $# -ge 1 ] || usage
release=$1
shift
built_tag=
publish=no
verify_files=()
while [ $# -gt 0 ]; do
  case "$1" in
    --built) [ $# -ge 2 ] || usage; built_tag=$2; shift 2 ;;
    --verify) [ $# -ge 2 ] || usage; verify_files+=("$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"); shift 2 ;;
    --publish) publish=yes; shift ;;
    *) usage ;;
  esac
done

[[ "$release" =~ ^v[0-9]{4}\.[0-9]{2}\.[0-9]{2}-[0-9]+$ ]] || { echo "release tag $release is not vYYYY.MM.DD-N" >&2; exit 64; }

cd "$root"
[ -z "$(git status --porcelain)" ] || { echo "the working tree has changes, commit or stash them first" >&2; exit 1; }
git fetch -q origin
commit=$(git rev-parse HEAD)
git merge-base --is-ancestor "$commit" origin/main || { echo "$commit is not on origin/main yet, push it first" >&2; exit 1; }
if gh release view "$release" -R "$gh_repo" > /dev/null 2>&1 || [ -n "$(git ls-remote --tags origin "refs/tags/$release")" ]; then
  echo "$release already exists on github" >&2
  exit 1
fi

user=$(gh api user --jq .login)
token=$(gh auth token)
context=$(docker context show)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export DOCKER_CONFIG="$work/docker"
mkdir -p "$DOCKER_CONFIG"
for entry in "${HOME}/.docker"/*; do
  [ "$(basename "$entry")" = config.json ] || ln -s "$entry" "$DOCKER_CONFIG/"
done
printf '%s' "$token" | python3 -I -c 'import base64, json, os, sys
path, user, context = sys.argv[1:]
auth = base64.b64encode(f"{user}:{sys.stdin.read()}".encode()).decode()
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as config:
    json.dump({"auths": {"ghcr.io": {"auth": auth}}, "currentContext": context}, config)' "$DOCKER_CONFIG/config.json" "$user" "$context"
echo "using ghcr.io as $user through a throwaway docker config"

out="$root/build/release/$release"
rm -rf "$out"
mkdir -p "$out/assets"

json() {
  python3 -I -c 'import json, sys
value = json.load(open(sys.argv[1]))
for key in sys.argv[2:]:
    value = value[key]
print(value)' "$@"
}

build_and_push() {
  if ! docker buildx inspect "$builder" > /dev/null 2>&1; then
    printf '[registry."docker.io"]\n  mirrors = ["mirror.gcr.io"]\n' > "$work/buildkitd.toml"
    docker buildx create --name "$builder" --driver docker-container --buildkitd-config "$work/buildkitd.toml" > /dev/null
    echo "created the $builder buildx builder, it keeps its build cache between releases"
  fi
  local native seed image arch digest
  native=$(docker version -f '{{.Server.Arch}}')
  seed="$out/woo-seed"
  docker buildx build --builder "$builder" --platform "linux/$native" --target woo-seed \
    --output "type=local,dest=$seed" images/woo-app
  echo "built the woocommerce seed on $native"
  for image in "${built[@]}"; do
    local sources=()
    for arch in "${arches[@]}"; do
      local args=(--builder "$builder" --platform "linux/$arch" --provenance=false --sbom=false
        --label "org.opencontainers.image.source=https://github.com/$gh_repo"
        --label "org.opencontainers.image.revision=$commit"
        --label "org.opencontainers.image.title=$image"
        --output "type=image,name=$registry/$image,push-by-digest=true,name-canonical=true,push=true"
        --metadata-file "$work/$image-$arch.json")
      case "$image" in
        woo-*) args+=(--build-context "woo-seed=$seed") ;;
      esac
      docker buildx build "${args[@]}" "images/$image"
      digest=$(json "$work/$image-$arch.json" containerimage.digest)
      echo "pushed $registry/$image@$digest for linux/$arch"
      sources+=("$registry/$image@$digest")
    done
    docker buildx imagetools create \
      --annotation "index:org.opencontainers.image.source=https://github.com/$gh_repo" \
      --annotation "index:org.opencontainers.image.revision=$commit" \
      -t "$registry/$image:$commit" "${sources[@]}"
    echo "merged $registry/$image:$commit"
  done
  scripts/mirror
}

if [ -z "$built_tag" ]; then
  built_tag=$commit
  echo "building every image for $commit on both architectures"
  build_and_push
else
  echo "releasing images already built as $built_tag, from commit $commit"
fi

scripts/resolve-images "$built_tag" > "$out/images-resolved.json"

for file in "${verify_files[@]}"; do
  arch=$(json "$file" arch)
  cp "$file" "$out/verify-$arch.json"
  echo "reusing verify results for $arch from $file"
done

for arch in "${arches[@]}"; do
  refs="$out/refs-$arch.json"
  scripts/platform-refs "$out/images-resolved.json" "linux/$arch" > "$refs"
  if [ ! -s "$out/verify-$arch.json" ]; then
    echo "verifying $arch"
    scripts/measure-unpacked "$refs" > "$out/sizes-$arch.json"
    verify/all.sh "$out/verify-$arch" "$refs"
    python3 verify/collect.py "$out/verify-$arch" "$arch" "$out/sizes-$arch.json" "$refs" > "$out/verify-$arch.json"
  fi
  python3 -I -c 'import json, sys
verify, refs, arch = json.load(open(sys.argv[1])), json.load(open(sys.argv[2])), sys.argv[3]
machine = {"x86_64": "amd64", "amd64": "amd64", "aarch64": "arm64", "arm64": "arm64"}.get(verify["host"]["machine"])
if verify["arch"] != arch:
    raise SystemExit(f"{sys.argv[1]} holds {verify['arch']} results, not {arch}")
if "refs" not in verify:
    print(f"{arch} verify results do not record digests, trusting that they cover {refs['wrk'].split('@')[1][:19]} and friends")
elif verify["refs"] != refs:
    changed = sorted(n for n in refs if verify["refs"].get(n) != refs[n])
    raise SystemExit(f"{arch} verify results cover different digests for {', '.join(changed)}")
if machine != arch:
    print(f"{arch} was verified under emulation on {verify['host']['machine']}, so its throughput and memory numbers run high")' \
    "$out/verify-$arch.json" "$refs" "$arch"
done

woo_app=$(json "$out/refs-$(docker version -f '{{.Server.Arch}}').json" woo-app)
docker run --rm --entrypoint cat "$woo_app" /usr/share/rackcensus/woocommerce.json > "$out/woocommerce.json"
echo "read the woocommerce seed manifest out of $woo_app"

scripts/pts-archive "$out/assets"

frameworks=()
read -r fork_repo fork_release fork_asset < <(python3 -I -c 'import json, sys
lock = json.load(open(sys.argv[1]))
print(lock["repo"], lock["release"] or "-", lock["asset"])' frameworks.lock)
if [ "$fork_release" != "-" ]; then
  gh release download "$fork_release" -R "$fork_repo" -p "$fork_asset" -D "$out/fork"
  frameworks=(--frameworks "$out/fork/$fork_asset")
fi

scripts/assemble-manifest --release "$release" --resolved "$out/images-resolved.json" \
  --verify "$out/verify-amd64.json" --verify "$out/verify-arm64.json" \
  --woo-seed "$out/woocommerce.json" --pts-dir "$out/assets" "${frameworks[@]}" > "$out/assets/images.json"
python3 -I -c 'import hashlib, json, pathlib, sys
assets, lock = pathlib.Path(sys.argv[1]), json.load(open(sys.argv[2]))
names = ["images.json", lock["archive"]["file"]] + [d["file"] for d in lock["downloads"]]
lines = [f"{hashlib.sha256((assets / n).read_bytes()).hexdigest()}  {n}" for n in names]
(assets / "SHA256SUMS").write_text("\n".join(lines) + "\n")' "$out/assets" pts.lock
scripts/release-notes "$out/assets/images.json" > "$out/notes.md"
echo "assembled $out/assets/images.json"

if [ "$publish" != yes ]; then
  echo "dry run, nothing was published. pass --publish to tag the images and create $release"
  exit 0
fi

scripts/anon-pull "$out/images-resolved.json"
python3 -I -c 'import json, sys
for image in json.load(open(sys.argv[1]))["images"].values():
    print(image["repo"], image["index"])' "$out/images-resolved.json" |
while read -r repo index; do
  docker buildx imagetools create -t "$repo:$release" "$repo@$index"
  tagged=$(docker buildx imagetools inspect "$repo:$release" --format '{{json .Manifest}}' | python3 -I -c 'import json, sys; print(json.load(sys.stdin)["digest"])')
  [ "$tagged" = "$index" ] || { echo "$repo:$release points at $tagged, expected $index" >&2; exit 1; }
  echo "tagged $repo:$release"
done
gh release create "$release" "$out/assets"/* -R "$gh_repo" --target "$commit" --title "$release" --notes-file "$out/notes.md"
echo "published $release"
