#!/venv/bin/python
import http.client
import sys

connection = http.client.HTTPConnection("127.0.0.1", 8000, timeout=30)
try:
    connection.request("GET", sys.argv[1] if len(sys.argv) > 1 else "/", headers={"Host": "wagtail"})
    response = connection.getresponse()
    response.read()
except OSError as error:
    print(error, file=sys.stderr)
    sys.exit(1)
print(response.status, end="")
